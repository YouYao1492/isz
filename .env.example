# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE SHEETS CATALOG INTEGRATION (Optional - if omitted, bundled demo dataset is used)
# GOOGLE_SHEET_ID: The ID from your Google Sheet URL (https://docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=""

# GOOGLE_SHEET_CSV_URL: Direct published CSV URL (File > Share > Publish to web > CSV)
# e.g. "https://docs.google.com/spreadsheets/d/e/2PACX-1v.../pub?gid=0&single=true&output=csv"
GOOGLE_SHEET_CSV_URL=""

# GOOGLE_API_KEY: Optional Google Cloud API Key with Google Sheets API v4 enabled
GOOGLE_API_KEY=""

# CATALOG_CACHE_TTL_SECONDS: Cache revalidation duration in seconds (defaults to 300)
CATALOG_CACHE_TTL_SECONDS="300"

